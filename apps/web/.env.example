# GraphQL endpoints.
#
# CRITICAL: use same-origin relative paths, NOT localhost URLs.
# .env.local is shipped inside the production tarball (deploy scripts do not
# exclude it), so these values are baked into the production JS bundle at
# build time. A localhost address baked into production resolves to each
# end-user's own machine, breaking every GraphQL call in production.
#
# In dev, Next.js rewrites /api/graphql → http://localhost:4000/graphql.
# In prod, nginx proxies /api/graphql → the NestJS backend on port 4000.
# Same-origin paths work in both environments without bake-time branching.
NEXT_PUBLIC_GRAPHQL_HTTP_URL=/api/graphql
NEXT_PUBLIC_GRAPHQL_WS_URL=/api/graphql

# Optional override. The "Dev login" button on the sign-in page is shown
# automatically when the page is served from localhost (or any *.localhost
# host). Set this to "true" to force-enable it on a non-localhost host
# (e.g. a tunnel or a custom dev domain). NEVER set this in production.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=false